# BypassX Management environment variables
# Copy this file to .env for local development. Never commit the real .env.

# Discord application bot token
BOT_TOKEN=

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:password@localhost:5432/bypassx?schema=public

# Discord user ID of the bot owner (digits only)
BOT_OWNER_ID=

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: comma-separated Discord guild IDs for fast slash-command sync locally.
# If empty, commands synchronize globally.
DEV_GUILD_IDS=
